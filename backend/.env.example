PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=substitua-por-um-segredo-longo-e-aleatorio
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forentis
DB_USER=postgres
DB_PASSWORD=configure-sua-senha
# Na VPS, DATABASE_URL substitui DB_HOST/PORT/NAME/USER/PASSWORD.
# DATABASE_URL=postgresql://usuario:senha@servico-postgres:5432/forentis

# Somente no servidor. Nunca use VITE_OPENAI_API_KEY ou publique a chave.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Gmail: use uma senha de app. Cada variável deve ocupar uma linha.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Apliq Tecnologia <apliqtecnologia@gmail.com>"
